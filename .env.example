DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL is required in production and for concurrency verification.
# DATABASE_URL=postgresql://restaurant:password@localhost:5432/restaurant
# Without DATABASE_URL, DEBUG=true uses a local SQLite database for a quick preview only.
LOCAL_DB=local.sqlite3
# For a custom production domain:
# CSRF_TRUSTED_ORIGINS=https://restaurant.example.com
